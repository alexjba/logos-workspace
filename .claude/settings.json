{
  "permissions": {
    "allow": ["Bash(git worktree *)", "Bash(gh pr *)", "Bash(gh issue *)", "Bash(gh api *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-git.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mac-guard.sh" }
        ]
      }
    ]
  }
}
