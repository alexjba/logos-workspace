# hasTests detection — sourced by `ws` (for `ws sync-graph`) and unit-tested by
# scripts/tests/detect-tests.test.sh.
#
# Answers "does this repo's flake expose checks?" by reading flake.nix rather
# than evaluating it: a real `nix eval` of checks.<system> would have to fetch
# every input of every repo, which sync-graph (run on every pin) cannot afford.
#
# Two of the three forms below are generated by logos-module-builder, so the
# repo's own flake.nix never spells `checks` out.  Missing those is what made
# `ws test` exit 0 having run nothing for every module repo whose tests live in
# tests/ — see logos-workspace#57.

# flake_declares_tests <repo-dir> — 0 if the repo's flake exposes checks.
flake_declares_tests() {
  local flake_file="$1/flake.nix"
  [[ -f "$flake_file" ]] || return 1

  # An explicit `checks = ` output, at any nesting depth.
  grep -qE '^[[:space:]]+checks[[:space:]]*=' "$flake_file" && return 0

  # A `tests = ` argument to mkLogosModule, which the builder turns into
  # checks.<system>.unit-tests (logos-module-builder/lib/mkLogosModule.nix,
  # `optionalTests`).  Anchored on the attribute name so that `unit-tests =`,
  # `testsPackage =` and a commented-out `# tests =` do not match.
  grep -qE '^[[:space:]]*tests[[:space:]]*=' "$flake_file" && return 0

  # A mkLogosQmlModule repo shipping tests/*.mjs, which the builder auto-detects
  # into checks.<system>.integration-test (mkLogosQmlModule.nix, `hasUiTests`).
  # Nothing in the flake.nix says so, so this one has to probe the directory.
  if grep -q 'mkLogosQmlModule' "$flake_file"; then
    local mjs
    for mjs in "$1"/tests/*.mjs; do
      [[ -f "$mjs" ]] && return 0
    done
  fi

  return 1
}
